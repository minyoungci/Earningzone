# ─────────────────────────────────────────────────────────────
#  tossbot 환경설정 — 이 파일을 .env 로 복사하고 키를 채우세요.
#  파일 설정을 사용할 때 직접 복사하세요. 실행 스크립트는 자동 복사하지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── [필수] 토스증권 Open API 키 ──────────────────────────────
#  토스증권 WTS(www.tossinvest.com) > 설정 > Open API 에서 발급.
#  ⚠️ 다른 PC/네트워크에서 실행하면 그 환경의 '공인 IP'를 토스 개발자센터의
#     허용 IP 에 추가해야 합니다(안 하면 분석이 안 됩니다). 현재 IP: https://api.ipify.org
TOSS_CLIENT_ID=tsck_live_여기에_클라이언트키
TOSS_CLIENT_SECRET=tssk_live_여기에_시크릿키

# 1 = 분석 전용(주문 안 함, 권장 기본값)   0 = 실주문(주의)
TOSS_DRY_RUN=1

# ─────────────────────────────────────────────────────────────
#  아래는 전부 [선택] — 비워두면 해당 기능만 꺼집니다(키만 넣어도 정상 실행).
# ─────────────────────────────────────────────────────────────

# ── [선택] 한국투자증권(KIS) — 자동매매 주문 실행 브로커 옵션 ──
#  apiportal.koreainvestment.com 에서 앱키 발급 + 모의투자 신청.
#  분석/차트는 토스 데이터 공유, 주문 실행만 KIS 로 전환할 때 사용.
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT=12345678-01
# KIS_PAPER=1                # 1 = 모의투자(VTS) 서버(기본)  0 = 실전(주의)

# ── [선택] 텔레그램 알림 + 원격 컨트롤 (자세히: TELEGRAM_GUIDE.md) ──
#  @BotFather 로 봇 생성 → 봇 토큰,  @userinfobot 으로 내 chat ID 확인.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── [선택] 디스코드 알림(웹훅) ────────────────────────────────
#  디스코드 채널 설정 > 연동 > 웹훅 만들기 → URL.
# DISCORD_WEBHOOK_URL=

# ── [선택] 외부 공개 시 쓰기 보호 토큰 ────────────────────────
#  Cloudflare Tunnel 등으로 외부에 공개할 때만 설정. 설정하면 열람(GET)은
#  자유지만 주문/오토파일럿 등 컨트롤(POST)은 이 토큰 소유자만 가능.
#  비워두면 게이트 OFF(로컬 개발용 — 컨트롤 자유).
# ACCESS_TOKEN=

# ── [선택] 자동매매 실행 브로커 기본값 (toss | kis) ──────────
# BROKER=toss
